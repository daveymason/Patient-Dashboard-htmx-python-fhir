# Copy to .env and fill in. Never commit the real file.

# REQUIRED. The app refuses to start in production without this.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Your own wallet address, granted administrator access on first boot so there
# is a way into a fresh install. Every other wallet starts as 'pending' and
# must be approved by an administrator before it can see any patient data.
#
# Leave blank if you would rather grant access after startup:
#   flask --app app grant-admin 0xYourWalletAddress
#
# Deliberately empty rather than a placeholder address: a forgotten placeholder
# would seed an administrator nobody can sign in as, locking you out entirely.
INITIAL_ADMIN_WALLET=

# FHIR backend.
FHIR_SERVER_URL=http://hapi.fhir.org/baseR4
FHIR_TIMEOUT=10
FHIR_PAGE_SIZE=20

# Where the SQLite user store and audit log live.
DATABASE_PATH=./instance/dashboard.db

# Session hardening. Leave SESSION_COOKIE_SECURE=true anywhere with TLS.
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=60

# Salt for pseudonymising identifiers in logs. Keep this stable so entries
# stay correlatable across restarts, and keep it secret.
LOG_HASH_SALT=
LOG_LEVEL=INFO
LOG_JSON=true

# Set true only for local development.
FLASK_DEBUG=false

# Exposes the FHIR backend URL on /health. Off by default.
HEALTH_SHOW_BACKEND=false

RATELIMIT_AUTH=10 per minute
