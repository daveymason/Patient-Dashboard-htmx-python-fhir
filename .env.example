# Copy to .env and fill in. Never commit the real file.

# REQUIRED. The app refuses to start in production without this.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Your own login, granted administrator access on first boot so there is a way
# into a fresh install. Every other account starts as 'pending' after it
# registers and must be approved by an administrator before it can see any
# patient data. Both must be set together, or neither is used.
#
# Leave both blank if you would rather grant access after startup:
#   flask --app app grant-admin yourusername
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# FHIR backend.
FHIR_SERVER_URL=https://hapi.fhir.org/baseR4
FHIR_TIMEOUT=10
FHIR_PAGE_SIZE=20

# Where the SQLite user store and audit log live.
DATABASE_PATH=./instance/dashboard.db

# Session hardening. Leave SESSION_COOKIE_SECURE=true anywhere with TLS.
SESSION_COOKIE_SECURE=true
SESSION_LIFETIME_MINUTES=60

# Salt for pseudonymising identifiers in logs. Keep this stable so entries
# stay correlatable across restarts, and keep it secret.
LOG_HASH_SALT=
LOG_LEVEL=INFO
LOG_JSON=true

# Set true only for local development.
FLASK_DEBUG=false

# Exposes the FHIR backend URL on /health. Off by default.
HEALTH_SHOW_BACKEND=false

RATELIMIT_AUTH=10 per minute

# -- AI ---------------------------------------------------------------------
# Read from the environment, never stored in the database: the SQLite file is
# unencrypted at rest, so the API key is the last thing that belongs in it.
OPENAI_API_KEY=
# Verify this against your account on the AI Settings page -- a wrong or
# retired model ID otherwise fails at the first real request.
AI_MODEL=gpt-5.6-luna
AI_REQUEST_TIMEOUT=60
# Reasoning tokens bill at the output rate, so this is the main cost lever.
# none / low / medium / high / xhigh / max. Blank omits the parameter.
AI_REASONING_EFFORT=low

# AI features stay off unless FHIR_SERVER_URL is a known synthetic-data server.
# Set true ONLY with a BAA (US) or processor agreement + DPIA (UK/EU) in place:
# it permits real patient data to be sent to the model provider.
AI_ALLOW_REAL_PHI=false

# Withhold name, address, contact details, record numbers and exact date of
# birth from the context sent to the model. 'auto' turns this on whenever
# FHIR_SERVER_URL is not a known synthetic server; true/false force it.
# This reduces what the provider sees. It is NOT full de-identification --
# resource ids remain, so a reader with server access can still re-identify.
# AI_ALLOW_REAL_PHI is the control that matters; this is defence in depth.
AI_DEIDENTIFY=auto

# The point at which a patient record stops being sent whole and starts being
# curated, oldest and least critical entries first. Allergies are never
# dropped. A complete record measures ~19K tokens against a 1,050,000-token
# window, so this is a guard for outliers, not a routine limit.
AI_CONTEXT_TOKEN_CEILING=120000
